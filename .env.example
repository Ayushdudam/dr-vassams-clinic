# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://dr-vassams-clinic.example.com

# Resend Transactional Email Delivery (Optional for local browsing; required for live email dispatch)
# Sign up at https://resend.com to generate an API key
RESEND_API_KEY=re_your_api_key_here

# Notification recipient (clinic administration email)
CLINIC_NOTIFY_EMAIL=clinic@example.com

# Verified sender email domain on Resend (e.g., appointments@yourdomain.com)
FROM_EMAIL=appointments@dr-vassams-clinic.example.com
